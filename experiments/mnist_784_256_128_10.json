{
  "name": "mnist_784_256_128_10",
  "topology": [784, 256, 128, 10],
  "data": {
    "x_train": "data/X_train_small.csv",
    "y_train": "data/Y_train_small.csv",
    "x_test":  "data/X_test_small.csv",
    "y_test":  "data/Y_test_small.csv"
  },
  "hidden_activation": "relu",
  "train": {
    "epochs":     1000,
    "batch_size": 128
  },
